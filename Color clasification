import serial
import time
import numpy as np
import matplotlib.pyplot as plt

# Configuración del puerto serial
port = 'COM5'  # Cambiar según el puerto correspondiente
baudRate = 9600
arduino = serial.Serial(port, baudRate, timeout=1)
time.sleep(2)  # Esperar a que el puerto serial esté listo

# Inicializar almacenamiento
N = 100  # Número de muestras deseadas
rgb_data = np.zeros((3, N))  # Para almacenar valores RGB
t = np.linspace(0, N * 0.1, N)  # Simular el tiempo (0.1 s entre muestras)

try:
    print("Leyendo datos del Arduino...")
    for i in range(N):
        # Leer una línea desde el puerto serial
        line = arduino.readline().decode('utf-8').strip()
        if line:
            try:
                # Separar los valores RGB
                rojo, verde, azul = map(float, line.split(","))
                rgb_data[:, i] = [rojo, verde, azul]
            except ValueError:
                print(f"Error al procesar línea: {line}")
        time.sleep(0.1)  # Tiempo entre lecturas (ajustar según Arduino)
finally:
    arduino.close()  # Cerrar el puerto serial
    print("Conexión cerrada.")

# Guardar los datos en un archivo
with open('tcs230_data.npy', 'wb') as f:
    np.save(f, rgb_data)
    np.save(f, t)

# Graficar los datos
colors = ['Rojo', 'Verde', 'Azul']
for i in range(3):
    plt.plot(t, rgb_data[i, :], label=colors[i])

plt.xlabel('Tiempo (s)')
plt.ylabel('Intensidad (pulsos)')
plt.title('Lecturas del Sensor TCS230')
plt.legend()
plt.grid()
plt.show()
